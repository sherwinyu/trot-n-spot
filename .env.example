# Copy to .env and fill in. For local dev these come from `npx supabase start`;
# for the real backend, from the Supabase project dashboard.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: deployed receipt API. Uses the current Supabase sign-in, no extra token.
EXPO_PUBLIC_RECEIPTS_API_URL=
