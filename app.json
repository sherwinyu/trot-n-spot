{
  "expo": {
    "name": "Quest",
    "slug": "trot-n-spot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quest",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trotnspot.quest",
      "infoPlist": {
        "NSCameraUsageDescription": "Quest needs camera access to photograph things for your partner to find.",
        "NSLocationWhenInUseUsageDescription": "Quest records your location when you create a quest so you can see where you found things.",
        "NSPhotoLibraryUsageDescription": "Quest needs photo library access to select photos for quests."
      }
    },
    "android": {
      "package": "com.trotnspot.quest",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Quest needs camera access to photograph things for your partner to find."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quest records your location when you create a quest so you can see where you found things.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Quest needs photo library access to select photos for quests."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3789c0fb-9573-430b-abd1-cad189032208"
      }
    },
    "owner": "sherwinyu"
  }
}
