{
  "expo": {
    "name": "TrotNSpot",
    "slug": "trot-n-spot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quest",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.sherwinyu.trotnspot",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "TrotNSpot uses your camera for quest photos and grocery receipts.",
        "NSLocationWhenInUseUsageDescription": "TrotNSpot records your location when you create a quest so you can see where you found things.",
        "NSPhotoLibraryUsageDescription": "TrotNSpot uses your photo library to select quest photos and grocery receipts."
      }
    },
    "android": {
      "package": "xyz.sherwinyu.trotnspot",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "TrotNSpot uses your camera for quest photos and grocery receipts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrotNSpot records your location when you create a quest so you can see where you found things.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrotNSpot uses your photo library to select quest photos and grocery receipts.",
          "cameraPermission": "TrotNSpot uses your camera for quest photos and grocery receipts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3789c0fb-9573-430b-abd1-cad189032208"
      }
    },
    "owner": "sherwinyu",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3789c0fb-9573-430b-abd1-cad189032208"
    }
  }
}
