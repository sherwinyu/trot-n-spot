{
  "name": "@bowl/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "worker": "node --env-file=.env --import tsx src/worker-main.ts",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@bowl/shared": "1.0.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "sharp": "^0.34.0",
    "zod": "^4.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.0.0"
  }
}
