# Run npm run setup to generate .env with private random app/database tokens.
APP_TOKEN=GENERATE_WITH_NPM_RUN_SETUP
POSTGRES_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
DATABASE_URL=postgres://bowl:GENERATE_WITH_NPM_RUN_SETUP@localhost:5432/bowl
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
# local retains original bytes in a persistent volume; s3 uses an existing private bucket.
STORAGE_DRIVER=local
STORAGE_DIR=./data/images
S3_BUCKET=receipts
S3_REGION=us-east-1
# For S3-compatible providers, set S3_ENDPOINT and standard AWS credentials.
# S3_ENDPOINT=https://your-s3-endpoint.example
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
