# Same Supabase project as Trot n Spot. Server-only credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Copy the Session pooler URI from Supabase Connect. URL-encode the DB password.
# Use TLS for hosted Supabase. The postgres login must be able to SET ROLE receipts_api.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
